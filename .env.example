# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Where the medallion data lives. Defaults to ./data in the repo.
STRAWBERRY_DATA_DIR=

# Where trained weights/checkpoints are written. Defaults to ./models in the repo.
STRAWBERRY_MODELS_DIR=

# Hugging Face Hub (downloading gated models / pushing checkpoints)
HF_TOKEN=

# Dataset sources used for bronze ingestion
KAGGLE_USERNAME=
KAGGLE_KEY=
ROBOFLOW_API_KEY=
